# Builds typst-rails into a real .gem package (as if cut for release) and
# installs it with `gem install`, exactly how an end user would -- as opposed
# to every other scenario here, which bundles it via a Bundler `path:` dependency
# against the working tree. Also installs the Typst CLI so the backend has
# something to auto-detect.
FROM ruby:3.4-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
      curl ca-certificates xz-utils build-essential libyaml-dev git \
    && rm -rf /var/lib/apt/lists/*

ARG TYPST_VERSION=0.13.1
RUN curl -fsSL "https://github.com/typst/typst/releases/download/v${TYPST_VERSION}/typst-x86_64-unknown-linux-musl.tar.xz" \
      -o /tmp/typst.tar.xz \
    && tar -xf /tmp/typst.tar.xz -C /tmp \
    && mv /tmp/typst-x86_64-unknown-linux-musl/typst /usr/local/bin/typst \
    && rm -rf /tmp/typst.tar.xz /tmp/typst-x86_64-unknown-linux-musl \
    && typst --version

WORKDIR /build
COPY . /build

RUN gem build typst-rails.gemspec \
    && gem install --no-document ./typst-rails-*.gem

WORKDIR /app
COPY e2e-tests/docker/scenarios/fresh_install_test.rb /app/fresh_install_test.rb

CMD ["ruby", "fresh_install_test.rb"]
